prefix=./android-build/arm64-v8a
exec_prefix=${prefix}
libdir=./android-build/arm64-v8a/lib
includedir=./android-build/arm64-v8a/include

Name: libavcodec
Description: FFmpeg codec library
Version: 61.3.100
Requires: 
Requires.private: libswresample >= 5.1.100, libavutil >= 59.8.100
Conflicts:
Libs: -L${libdir}  -lavcodec 
Libs.private: -pthread -lm -latomic -landroid
Cflags: -I${includedir}
