prefix=./build-mediamagician/arch-build/x86_64
exec_prefix=${prefix}
libdir=./build-mediamagician/arch-build/x86_64/lib
includedir=./build-mediamagician/arch-build/x86_64/include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 10.1.100
Requires: 
Requires.private: libswscale >= 8.1.100, libavformat >= 61.1.102, libavcodec >= 61.3.100, libswresample >= 5.1.100, libavutil >= 59.8.100
Conflicts:
Libs: -L${libdir}  -lavfilter 
Libs.private: -pthread -lm -latomic
Cflags: -I${includedir}
