prefix=./build-mediamagician/arch-build/x86_64
exec_prefix=${prefix}
libdir=./build-mediamagician/arch-build/x86_64/lib
includedir=./build-mediamagician/arch-build/x86_64/include

Name: libavcodec
Description: FFmpeg codec library
Version: 61.3.100
Requires: 
Requires.private: libswresample >= 5.1.100, libavutil >= 59.8.100
Conflicts:
Libs: -L${libdir}  -lavcodec 
Libs.private: -lvpx -lm -lvpx -lm -lvpx -lm -lvpx -lm -pthread -lm -latomic -llzma -ldav1d -laom -lopus -lx264 -lx265 -lz
Cflags: -I${includedir}
