prefix=./build-mediamagician/arch-build/x86_64
exec_prefix=${prefix}
libdir=./build-mediamagician/arch-build/x86_64/lib
includedir=./build-mediamagician/arch-build/x86_64/include

Name: libavformat
Description: FFmpeg container format library
Version: 61.1.100
Requires: 
Requires.private: libavcodec >= 61.3.100, libswresample >= 5.1.100, libavutil >= 59.8.100
Conflicts:
Libs: -L${libdir}  -lavformat 
Libs.private: -lm -latomic -lbz2 -lz
Cflags: -I${includedir}
