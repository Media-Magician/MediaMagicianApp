prefix=./build-mediamagician/windows-build/x86_64
exec_prefix=${prefix}
libdir=./build-mediamagician/windows-build/x86_64/lib
includedir=./build-mediamagician/windows-build/x86_64/include

Name: libavcodec
Description: FFmpeg codec library
Version: 61.3.100
Requires: 
Requires.private: libswresample >= 5.1.100, libavutil >= 59.8.100
Conflicts:
Libs: -L${libdir}  -lavcodec 
Libs.private: -liconv -lm -latomic -llzma -lx264 -lmfuuid -lole32 -lstrmiids -lole32 -luser32 -lz
Cflags: -I${includedir}
